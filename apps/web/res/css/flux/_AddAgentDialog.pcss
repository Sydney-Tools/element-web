/* Flux: the "Add an agent" dialog (src/flux/AddAgentDialog.tsx). */

.fx_AddAgentDialog {
    min-width: 420px;
}

.fx_AddAgentDialog_intro,
.fx_AddAgentDialog_note,
.fx_AddAgentDialog_empty {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.fx_AddAgentDialog_error {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-critical-primary);
}

.fx_AddAgentDialog_list {
    list-style: none;
    margin: var(--cpd-space-3x) 0;
    padding: 0;
}

.fx_AddAgentDialog_row {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    padding: var(--cpd-space-2x) 0;
    border-top: 1px solid var(--cpd-color-border-interactive-secondary);
}

.fx_AddAgentDialog_text {
    flex: 1;
    min-width: 0;
}

.fx_AddAgentDialog_name {
    font: var(--cpd-font-body-md-semibold);
}

.fx_AddAgentDialog_tag {
    margin-left: var(--cpd-space-2x);
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
}

.fx_AddAgentDialog_blurb {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.fx_AddAgentDialog_state {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}
