/*
Gigawatt (Sydney Tools) — tokens and variables layered over the light theme.

Palette: white canvas, cool off-white panels, ink text, flux-orange accent
(the DeLorean's tail-lights) for actions and links.
*/

/* Compound design tokens. Same layer as the imported defaults so these win
   by source order (the same trick theme.ts uses for custom themes). */
@layer compound-tokens {
    :root,
    [class*="cpd-theme-"] {
        /* surfaces */
        --cpd-color-bg-canvas-default: #ffffff;
        --cpd-color-bg-subtle-secondary: #f4f6fa;
        --cpd-color-bg-subtle-primary: #e9edf4;

        /* text */
        --cpd-color-text-primary: #121722;
        --cpd-color-text-secondary: #5b6778;
        --cpd-color-text-on-solid-primary: #ffffff;
        --cpd-color-text-link-external: #c8401f;

        /* accent: flux orange */
        --cpd-color-text-action-accent: #e0512f;
        --cpd-color-icon-accent-primary: #e0512f;
        --cpd-color-bg-accent-rest: #ff6a4a;
        --cpd-color-bg-accent-hovered: #ff7f63;
        --cpd-color-bg-accent-pressed: #e8563a;
        --cpd-color-border-accent: #ff6a4a;
        --cpd-color-bg-action-primary-rest: #e8563a;
        --cpd-color-bg-action-primary-hovered: #ff6a4a;
        --cpd-color-bg-action-primary-pressed: #c8401f;
        --cpd-color-bg-action-primary-disabled: #f3b5a7;
        --cpd-color-border-focused: #ff6a4a;
    }
}

/* Element's theme variables (compile-time, so they must come after _light.pcss
   and before _components.pcss — see gigawatt.pcss). */
$menu-selected-color: #f4f6fa;
$togglesw-off-color: #c9d1dd;
$event-highlight-bg-color: #fff1ec;
$reaction-row-button-selected-bg-color: #ffe6df;
$eventbubble-self-bg: #fff1ec;
$eventbubble-others-bg: #f4f6fa;
$location-live-color: #e8563a;
$location-live-secondary-color: #ffd6cc;

/* The signed-out splash gets a faint flux glow instead of Element's pastel. */
.mx_SplashPage::before {
    background-image:
        radial-gradient(60% 70% at 85% 0%, rgb(255, 106, 74, 0.16) 0%, rgb(255, 106, 74, 0) 100%),
        radial-gradient(45% 45% at 0% 0%, rgb(125, 211, 252, 0.18) 0%, rgb(125, 211, 252, 0) 100%) !important;
}

/* Our own hooks (kept here so a glance at the theme shows what Gigawatt
   adds). Classes are prefixed gw_ to stay clear of upstream. */
.gw_accent {
    color: var(--cpd-color-text-action-accent);
}
