/* Flux: approval card (src/flux/ApprovalCard.tsx). */

.fx_ApprovalCard {
    margin: var(--cpd-space-1x) 0;
    padding: var(--cpd-space-3x) var(--cpd-space-4x);
    border: 1px solid var(--cpd-color-bg-accent-rest);
    border-radius: 12px;
    background: var(--cpd-color-bg-subtle-secondary);
    max-width: 560px;
}

.fx_ApprovalCard_approved {
    border-color: var(--cpd-color-border-success-subtle);
}

.fx_ApprovalCard_denied,
.fx_ApprovalCard_timed-out {
    border-color: var(--cpd-color-border-disabled);
    opacity: 0.85;
}

.fx_ApprovalCard_title {
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);
    margin-bottom: var(--cpd-space-2x);
}

.fx_ApprovalCard_tools {
    margin: 0 0 var(--cpd-space-2x);
    padding-left: var(--cpd-space-5x);
    font: var(--cpd-font-body-sm-regular);
}

.fx_ApprovalCard_tool {
    font-family: var(--cpd-font-family-mono);
}

.fx_ApprovalCard_args {
    margin: var(--cpd-space-1x) 0 0;
    padding: var(--cpd-space-2x);
    border-radius: 8px;
    background: var(--cpd-color-bg-canvas-default);
    font: var(--cpd-font-body-xs-regular);
    font-family: var(--cpd-font-family-mono);
    white-space: pre-wrap;
}

.fx_ApprovalCard_actions {
    display: flex;
    gap: var(--cpd-space-2x);
}

.fx_ApprovalCard_note {
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
}
